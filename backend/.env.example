# Backend — Variables de Entorno (copia esto en Vercel/Render/Railway)

PORT=5000
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/pasteleria_app?retryWrites=true&w=majority
JWT_SECRET=<genera_uno_seguro_de_32_chars_min>
JWT_EXPIRES_IN=7d
NODE_ENV=production

# Cloudinary (crea cuenta gratis en cloudinary.com)
CLOUDINARY_CLOUD_NAME=<tu_cloud_name>
CLOUDINARY_API_KEY=<tu_api_key>
CLOUDINARY_API_SECRET=<tu_api_secret>
